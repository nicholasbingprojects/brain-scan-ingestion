params {
    outdir = 'results'
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        process.container = 'python:3.11-slim'
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = 'brain-scan-compute-queue'
        aws.region = 'ap-southeast-2' // e.g., Sydney region for Australian repositories
        aws.batch.cliPath = '/usr/local/bin/aws'
    }
}